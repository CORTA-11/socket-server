# Copy to .env and adjust for your machine:
#   cp .env.example .env

# core-api base URL (used for membership checks)
CORE_API_URL=http://localhost:8080

# Must match core-api INTERNAL_API_KEY
INTERNAL_API_KEY=dev-internal-key-change-me

# Must match core-api JWT_SECRET (access-token validation)
JWT_SECRET=your-super-secret-key-change-in-production

# Redis Pub/Sub (must match core-api)
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_CHANNEL=corta:chat:events

# Listen port (WebSocket clients use ws://localhost:PORT/ws)
PORT=8081
