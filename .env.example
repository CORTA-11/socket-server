# Copy to .env and adjust for your machine:
#   cp .env.example .env

# Optional local debug endpoint guard for POST /internal/publish
INTERNAL_API_KEY=dev-internal-key-change-me

# Structured log level: debug or info.
LOG_LEVEL=info

# Must match core-api JWT_SECRET for socket-ticket validation
JWT_SECRET=development-socket-ticket-secret-change-me

# Redis Pub/Sub (must match core-api)
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_CHANNEL=corta:chat:events

# Listen port (WebSocket clients use ws://localhost:PORT/ws)
PORT=8081

# Browser origins allowed to open WebSocket connections.
SOCKET_ALLOWED_ORIGINS=http://localhost:10000,http://127.0.0.1:10000,http://localhost:3000,http://127.0.0.1:3000

# Hocuspocus collaboration process (Node 22+)
COLLABORATION_HOST=0.0.0.0
COLLABORATION_PORT=8082
