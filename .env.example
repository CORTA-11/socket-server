# Copy to .env and adjust for your machine:
#   cp .env.example .env

# Optional local debug endpoint guard for POST /internal/publish
INTERNAL_API_KEY=dev-internal-key-change-me

# Structured log level: debug or info.
LOG_LEVEL=info

# Must match core-api JWT_SECRET for socket-ticket validation
JWT_SECRET=development-socket-ticket-secret-change-me

# Redis Pub/Sub (must match core-api)
REDIS_URL=redis://localhost:6379/0
REDIS_CHAT_CHANNEL=corta:chat:events

# Listen port (WebSocket clients use ws://localhost:PORT/ws)
PORT=8081

# Browser origins allowed to open WebSocket connections.
SOCKET_ALLOWED_ORIGINS=http://localhost:10000,http://127.0.0.1:10000,http://localhost:3000,http://127.0.0.1:3000

# Hocuspocus collaboration process (Node 22+)
COLLABORATION_HOST=0.0.0.0
COLLABORATION_PORT=8082
CORE_API_INTERNAL_URL=http://localhost:8080
COLLABORATION_SERVICE_SECRET=development-collaboration-service-secret-change-me

# Collaboration resource and dependency bounds (bytes or milliseconds)
COLLABORATION_AUTHENTICATION_TIMEOUT_MS=60000
COLLABORATION_DEPENDENCY_TIMEOUT_MS=2000
COLLABORATION_MAX_WEBSOCKET_MESSAGE_BYTES=6291456
COLLABORATION_MAX_DOCUMENT_BYTES=6291456
COLLABORATION_MAX_BACKPRESSURE_BYTES=8388608
COLLABORATION_MAX_AUTHENTICATED_QUEUE_BYTES=12582912
COLLABORATION_MAX_AUTHENTICATED_QUEUE_MESSAGES=64
COLLABORATION_MAX_UNAUTHENTICATED_QUEUE_BYTES=262144
COLLABORATION_MAX_UNAUTHENTICATED_QUEUE_MESSAGES=64
COLLABORATION_MAX_PENDING_DOCUMENTS=1
COLLABORATION_MAX_PERSISTENCE_RESPONSE_BYTES=16777216
COLLABORATION_PERSISTENCE_DEBOUNCE_MS=2000
COLLABORATION_PERSISTENCE_MAX_DEBOUNCE_MS=10000
